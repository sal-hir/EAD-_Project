                                                                                    "pm.test(\"Accepted or replayed\", () =\u003e pm.expect(pm.response.code).to.be.oneOf([202, 200]));",
                                                                                    "if ([200, 202].includes(pm.response.code)) { pm.collectionVariables.set(\"orderId\", pm.response.json().data.id); pm.test(\"Pending booking\", () =\u003e pm.expect(pm.response.json().data.status).to.eql(\"PENDING_BOOKING\")); }"
                                                                                ],
