  "info": {
    "description": "Intake only: PENDING_BOOKING. Set credentials privately. OAuth create needs orders:write; GET needs merchant:read. Use one authentication folder. Repeat unchanged Create to test replay; change both order reference and key for a new order.",
    "name": "SwiftDrop Member 5 Merchant Orders",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "item": [
    {
      "name": "API key",
      "item": [
        {
          "request": {
            "body": {
              "raw": "{\r\n    \"merchantOrderId\":  \"{{merchantOrderId}}\",\r\n    \"pickup\":  {\r\n                   \"district\":  \"Colombo\",\r\n                   \"name\":  \"Shop\",\r\n                   \"phone\":  \"+94771234567\",\r\n                   \"address\":  \"1 Main Road\"\r\n               },\r\n    \"recipient\":  {\r\n                      \"district\":  \"Galle\",\r\n                      \"name\":  \"Customer\",\r\n                      \"phone\":  \"+94771234568\",\r\n                      \"address\":  \"2 Lake Road\"\r\n                  },\r\n    \"parcel\":  {\r\n                   \"heightCm\":  10,\r\n                   \"description\":  \"Books\",\r\n                   \"weightKg\":  1.5,\r\n                   \"lengthCm\":  20,\r\n                   \"widthCm\":  15\r\n               },\r\n    \"serviceType\":  \"STANDARD\"\r\n}",
              "options": {
                "raw": {
                  "language": "json"
                }
              },
              "mode": "raw"
            },
            "method": "POST",
            "url": "{{baseUrl}}/api/v1/merchant/orders",
            "header": [
              {
                "key": "Content-Type",
                "value": "application/json"
              },
              {
                "key": "Idempotency-Key",
                "value": "{{idempotencyKey}}"
              }
            ]
          },
          "name": "Create or replay order",
          "event": [
            {
              "script": {
                "exec": [
                  "pm.test(\"Accepted or replayed\", () => pm.expect(pm.response.code).to.be.oneOf([202, 200]));",
                  "if ([200, 202].includes(pm.response.code)) { pm.collectionVariables.set(\"orderId\", pm.response.json().data.id); pm.test(\"Pending booking\", () => pm.expect(pm.response.json().data.status).to.eql(\"PENDING_BOOKING\")); }"
                ],
                "type": "text/javascript"
              },
              "listen": "test"
            }
          ]
        },
        {
          "name": "List orders",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/merchant/orders?page=0&size=20"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Order details",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/merchant/orders/{{orderId}}"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));"
                ]
              }
            }
          ]
        },
        {
          "name": "Tracking availability",
          "request": {
            "method": "GET",
            "url": "{{baseUrl}}/api/v1/merchant/orders/{{orderId}}/tracking"
          },
          "event": [
            {
              "listen": "test",
              "script": {
                "type": "text/javascript",
                "exec": [
                  "pm.test('HTTP 200', () => pm.response.to.have.status(200));",
                  "pm.test('Success envelope', () => pm.expect(pm.response.json().success).to.eql(true));",
                  "pm.test('Pending tracking schema', () => { const d=pm.response.json().data; pm.expect(d.trackingAvailable).to.eql(false); pm.expect(d.events).to.be.an('array'); pm.expect(d.updatedAt).to.be.a('string'); });"
                ]
              }
            }
          ]
        }
      ],
      "auth": {
        "type": "apikey",
        "apikey": [
          {
            "key": "key",
