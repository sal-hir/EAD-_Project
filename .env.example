# Copy to .env and supply your own secrets. Do not commit .env.
AUTH_DB_USER=neondb_owner
AUTH_DB_PASSWORD=
AUTH_DB_URL=jdbc:postgresql://YOUR-ENDPOINT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require
# Direct endpoint for Flyway migrations (same database, without -pooler).
AUTH_MIGRATION_DB_URL=jdbc:postgresql://YOUR-ENDPOINT.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require
JWT_SECRET=
JWT_ISSUER=swiftdrop-auth
JWT_TTL_SECONDS=900
FRONTEND_URL=http://localhost:3000
VITE_API_URL=http://localhost:4000
COOKIE_SECURE=false
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
GOOGLE_REDIRECT_URI=http://localhost:4000/login/oauth2/code/google
# Auth-owned password recovery (SMTP sandbox or production SMTP).
MAIL_HOST=
MAIL_PORT=587
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_FROM=
MAIL_SMTP_AUTH=true
MAIL_SMTP_STARTTLS=true
# Backend-only approval integration, shared privately with Merchant Service.
MERCHANT_SERVICE_TOKEN=
# Optional separate Merchant database credentials; Compose defaults to Auth's
# database connection, with Merchant tables isolated in the merchant schema.
MERCHANT_DB_URL=
MERCHANT_MIGRATION_DB_URL=
MERCHANT_DB_USER=
MERCHANT_DB_PASSWORD=
VITE_MERCHANT_API_URL=http://localhost:4001
# Courier Service configuration (Member 6)
VITE_COURIER_API_URL=http://localhost:4003
COURIER_PORT=4003
COURIER_DB_USER=neondb_owner
COURIER_DB_PASSWORD=
COURIER_DB_URL=jdbc:postgresql://YOUR-ENDPOINT-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require
COURIER_MIGRATION_DB_URL=jdbc:postgresql://YOUR-ENDPOINT.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require
# Only needed if enabling the optional legacy-notifications Compose profile.
RABBITMQ_USER=swiftdrop
RABBITMQ_PASS=

# Member 3: Real-Time Tracking & AI Bot (Bonus +5)
TRACKING_PORT=4003
VITE_TRACKING_API_URL=http://localhost:4003
REDIS_HOST=localhost
REDIS_PORT=6379
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
