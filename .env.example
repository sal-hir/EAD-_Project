# Environment Variables — copy to .env and fill in your values
# Never commit .env to version control

# --- Database ---
POSTGRES_USER=swiftdrop
POSTGRES_PASSWORD=swiftdrop_secret
POSTGRES_DB=swiftdrop_db
DATABASE_URL=postgresql://swiftdrop:swiftdrop_secret@localhost:5432/swiftdrop_db

# --- RabbitMQ ---
RABBITMQ_USER=swiftdrop
RABBITMQ_PASS=swiftdrop_mq
RABBITMQ_URL=amqp://swiftdrop:swiftdrop_mq@localhost:5672

# --- JWT ---
JWT_SECRET=change_this_to_a_long_random_string_in_production
JWT_EXPIRES_IN=7d

# --- Google OAuth 2.0 (placeholder — replace with real credentials) ---
GOOGLE_CLIENT_ID=your_google_client_id_here
GOOGLE_CLIENT_SECRET=your_google_client_secret_here
GOOGLE_CALLBACK_URL=http://localhost:4000/api/v1/auth/google/callback

# --- Backend ---
PORT=4000
NODE_ENV=development
FRONTEND_URL=http://localhost:3000
API_BASE_URL=http://localhost:4000

# --- Email (Nodemailer / Ethereal auto-generates creds at startup) ---
# Leave blank to use Ethereal test account (recommended for dev)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
EMAIL_FROM=noreply@swiftdrop.com

# --- Webhook ---
WEBHOOK_SECRET=webhook_signing_secret_change_in_production
WEBHOOK_MAX_RETRIES=5

# --- Frontend (Vite build args) ---
VITE_API_URL=http://localhost:4000
VITE_SOCKET_URL=http://localhost:4000
