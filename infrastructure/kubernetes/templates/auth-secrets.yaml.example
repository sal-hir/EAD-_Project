# TEMPLATE ONLY. Copy into .kubernetes-local/, then replace placeholders privately.
apiVersion: v1
kind: Secret
metadata:
  name: auth-secrets
  labels:
    app.kubernetes.io/part-of: swiftdrop
    app.kubernetes.io/component: authentication
type: Opaque
stringData:
  AUTH_DB_PASSWORD: "REPLACE_WITH_AUTH_DATABASE_PASSWORD"
  JWT_SECRET: "REPLACE_WITH_RANDOM_JWT_SECRET_AT_LEAST_32_BYTES"
  # Optional: leave both empty to keep Google login disabled.
  GOOGLE_CLIENT_ID: ""
  GOOGLE_CLIENT_SECRET: ""
  # Optional password-recovery SMTP credentials.
  MAIL_USERNAME: ""
  MAIL_PASSWORD: ""
