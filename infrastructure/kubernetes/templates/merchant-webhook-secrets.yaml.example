apiVersion: v1
kind: Secret
metadata:
  name: merchant-webhook-secrets
type: Opaque
stringData:
  # Base64 encoding of exactly 32 random bytes. Shared by all Merchant replicas.
  # Keep this value stable: replacing it makes existing signing secrets unreadable.
  WEBHOOK_ENCRYPTION_KEY: "REPLACE_WITH_BASE64_32_RANDOM_BYTES"
