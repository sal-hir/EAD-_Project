MERCHANT_DB_URL=jdbc:postgresql://YOUR-ENDPOINT-pooler.example.neon.tech/neondb?sslmode=require&channelBinding=require
MERCHANT_MIGRATION_DB_URL=jdbc:postgresql://YOUR-ENDPOINT.example.neon.tech/neondb?sslmode=require&channelBinding=require
MERCHANT_DB_USER=
MERCHANT_DB_PASSWORD=
# Must match Auth Service's backend-only value; at least 32 random characters.
MERCHANT_SERVICE_TOKEN=
AUTH_SERVICE_URL=http://localhost:4000
FRONTEND_URL=http://localhost:3000
MERCHANT_PORT=4001
# Base64 of 32 cryptographically random bytes; required to configure webhooks.
WEBHOOK_ENCRYPTION_KEY=
WEBHOOK_WORKER_ENABLED=true
