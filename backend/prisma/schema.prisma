// This is your Prisma schema file,
// learn more about it in the docs: https://pris.ly/d/prisma-schema

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  CUSTOMER
  MERCHANT
  COURIER
  DISPATCHER
  ADMIN
}

enum ParcelSize {
  SMALL
  MEDIUM
  LARGE
}

enum ParcelStatus {
  CREATED
  PENDING_PICKUP
  PICKED_UP
  IN_TRANSIT
  OUT_FOR_DELIVERY
  DELIVERED
  FAILED
  CANCELLED
}

enum NotificationStatus {
  PENDING
  SENT
  FAILED
}

model User {
  id            String    @id @default(uuid())
  email         String    @unique
  passwordHash  String?
  name          String
  phone         String?
  role          Role      @default(CUSTOMER)
  googleId      String?   @unique
  isActive      Boolean   @default(true)
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt

  // Relations
  customerParcels     Parcel[]            @relation("CustomerParcels")
  parcelStatusUpdates ParcelStatusHistory[]
  notifications       Notification[]
  merchant            Merchant?
  courier             Courier?

  @@map("users")
}

model Merchant {
  id              String    @id @default(uuid())
  userId          String    @unique
  businessName    String
  businessEmail   String    @unique
  apiKey          String    @unique
  apiKeyHash      String
  webhookUrl      String?
  webhookSecret   String?
  isApproved      Boolean   @default(false)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  // Relations
  user    User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  parcels Parcel[]

  @@map("merchants")
}

model Courier {
  id          String    @id @default(uuid())
  userId      String    @unique
  vehicleType String?
  licenseNo   String?
  isAvailable Boolean   @default(true)
  zone        String?
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  // Relations
  user        User                @relation(fields: [userId], references: [id], onDelete: Cascade)
  assignments CourierAssignment[]
  parcels     Parcel[]

  @@map("couriers")
}

model Zone {
  id             String    @id @default(uuid())
  name           String    @unique
  description    String?
  baseFee        Float     @default(0)
  feePerKg       Float     @default(0)
  estimatedDays  Int       @default(1)
  isActive       Boolean   @default(true)
  createdAt      DateTime  @default(now())
  updatedAt      DateTime  @updatedAt

  // Relations
  parcels Parcel[]

  @@map("zones")
}

model Parcel {
  id              String        @id @default(uuid())
  trackingNumber  String        @unique
  customerId      String
  merchantId      String?
  courierId       String?
  zoneId          String
  
  // Addresses
  pickupAddress     String
  pickupCity        String
  pickupPostcode    String?
  dropoffAddress    String
  dropoffCity       String
  dropoffPostcode   String?
  
  // Recipient
  recipientName     String
  recipientPhone    String
  recipientEmail    String?
  
  // Parcel details
  weightKg        Float
  size            ParcelSize    @default(SMALL)
  description     String?
  estimatedFee    Float
  
  // Status
  status          ParcelStatus  @default(CREATED)
  
  // Timestamps
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  deliveredAt     DateTime?
  
  // Relations
  customer    User     @relation("CustomerParcels", fields: [customerId], references: [id])
  merchant    Merchant? @relation(fields: [merchantId], references: [id])
  courier     Courier?  @relation(fields: [courierId], references: [id])
  zone        Zone      @relation(fields: [zoneId], references: [id])
  
  statusHistory     ParcelStatusHistory[]
  courierAssignment CourierAssignment?
  webhookDeliveries WebhookDelivery[]

  @@map("parcels")
}

model ParcelStatusHistory {
  id            String       @id @default(uuid())
  parcelId      String
  status        ParcelStatus
  note          String?
  proofImageUrl String?
  failureReason String?
  updatedBy     String
  timestamp     DateTime     @default(now())

  // Relations
  parcel  Parcel @relation(fields: [parcelId], references: [id], onDelete: Cascade)
  updater User   @relation(fields: [updatedBy], references: [id])

  @@map("parcel_status_history")
}

model CourierAssignment {
  id          String    @id @default(uuid())
  courierId   String
  parcelId    String    @unique
  assignedAt  DateTime  @default(now())
  completedAt DateTime?
  assignedBy  String

  // Relations
  courier Courier @relation(fields: [courierId], references: [id])
  parcel  Parcel  @relation(fields: [parcelId], references: [id])

  @@map("courier_assignments")
}

model Notification {
  id        String             @id @default(uuid())
  userId    String?
  type      String             // EMAIL, SMS, WEBHOOK
  recipient String
  subject   String?
  body      String
  status    NotificationStatus @default(PENDING)
  sentAt    DateTime?
  error     String?
  createdAt DateTime           @default(now())

  // Relations
  user User? @relation(fields: [userId], references: [id])

  @@map("notifications")
}

model WebhookDelivery {
  id          String    @id @default(uuid())
  parcelId    String
  merchantId  String
  event       String
  payload     Json
  status      String    @default("PENDING") // PENDING, SUCCESS, FAILED, RETRYING
  attempts    Int       @default(0)
  lastAttempt DateTime?
  nextRetry   DateTime?
  response    String?
  createdAt   DateTime  @default(now())

  // Relations
  parcel Parcel @relation(fields: [parcelId], references: [id])

  @@map("webhook_deliveries")
}
