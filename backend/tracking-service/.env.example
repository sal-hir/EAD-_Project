# Tracking Service Local Environment Configuration
PORT=4003

# Database configuration:
# You can copy the EXACT spring.datasource properties from Dulan's auth-service.env!
spring.datasource.username=neondb_owner
spring.datasource.password=your_neon_password_from_dulan
spring.datasource.url=jdbc:postgresql://your-neon-endpoint-pooler.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require
spring.flyway.url=jdbc:postgresql://your-neon-endpoint.us-east-2.aws.neon.tech/neondb?sslmode=require&channelBinding=require

# Redis Cache configuration
REDIS_HOST=localhost
REDIS_PORT=6379
REDIS_PASSWORD=
TRACKING_CACHE_TTL=60

# Frontend origin for CORS
FRONTEND_URL=http://localhost:3000

# Google Gemini API (Bonus +5 marks)
# Get a free key at: https://aistudio.google.com/app/apikey
# If left blank, an intelligent built-in rule engine handles all answers!
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash
